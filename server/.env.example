# Better Auth Configuration
BETTER_AUTH_SECRET=your_secret_key_here
BETTER_AUTH_URL=http://localhost:8000

# Deterministic UUID generation key (used for /api/gaze/validate/uuid)
GAZE_UUID_ENCRYPTION_KEY=your_uuid_encryption_key_here

# GazeCore proxy configuration for /api/gaze/token and /api/gaze/gyro-snapshot
GAZECORE_BACKEND_URL=http://localhost:3000
GAZECORE_API_KEY=your_gazecore_api_key_here

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Database Configuration
DATABASE_URL=postgresql://user:password@host:port/database

# Telegram / TDLib Configuration
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_here
TDLIB_ENCRYPTION_KEY=change_me_to_a_long_random_secret
TDLIB_SESSIONS_DIR=./tdlib-sessions

# Deepgram Voice Agent Configuration
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_VOICE_AGENT_URL=wss://agent.deepgram.com/v1/agent/converse
DEEPGRAM_AGENT_LISTEN_MODEL=flux-general-en
DEEPGRAM_AGENT_LISTEN_VERSION=latest
DEEPGRAM_AGENT_THINK_PROVIDER=open_ai
DEEPGRAM_AGENT_THINK_MODEL=gpt-4o-mini
DEEPGRAM_AGENT_SPEAK_MODEL=aura-2-thalia-en
DEEPGRAM_AGENT_INPUT_SAMPLE_RATE=16000
DEEPGRAM_AGENT_OUTPUT_SAMPLE_RATE=24000
DEEPGRAM_AGENT_LANGUAGE=en
DEEPGRAM_AGENT_GREETING_TEMPLATE=Hi, I am the GazeConnect Bot. I am talking on behalf of {{patientName}}. What would you like to talk to {{patientName}} about?
DEEPGRAM_AGENT_USE_MOCK_DEFAULT=false
DEEPGRAM_AGENT_TEMP_OPENING=0.2
DEEPGRAM_AGENT_TEMP_DIRECT=0.2
DEEPGRAM_AGENT_TEMP_CANDIDATE=0.7
DEEPGRAM_AGENT_TEMP_RETRY=0.5
VOICE_AGENT_TRANSPORT_MODE=debug
VOICE_AGENT_ENABLED=false
VOICE_AGENT_POST_CALL_STORAGE_MODE=summary_only
VOICE_AGENT_ENDED_SESSION_TTL_SECONDS=900
# AI Talk Live (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_ALT_1=
GROQ_API_KEY_ALT_2=
GROQ_API_KEY_ALT_3=
GROQ_API_KEY_ALT_4=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3

# Google OAuth Credentials
# Get these from: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:8000/api/auth/callback/google (dev)
# Redirect URI: https://your-domain.com/api/auth/callback/google (prod)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Resend API Key for sending emails
RESEND_API_KEY=your_resend_api_key_here

# Optional future LLM provider keys
GROQ_API_KEY=your_groq_api_key_here
