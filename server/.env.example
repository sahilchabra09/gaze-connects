# Better Auth Configuration
BETTER_AUTH_SECRET=your_secret_key_here
BETTER_AUTH_URL=http://localhost:8000

# Deterministic UUID generation key (used for /api/gaze/validate/uuid)
GAZE_UUID_ENCRYPTION_KEY=your_uuid_encryption_key_here

# GazeCore proxy configuration for /api/gaze/token and /api/gaze/gyro-snapshot
GAZECORE_BACKEND_URL=http://localhost:3000
GAZECORE_API_KEY=your_gazecore_api_key_here

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Database Configuration
DATABASE_URL=postgresql://user:password@host:port/database

# Google OAuth Credentials
# Get these from: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:8000/api/auth/callback/google (dev)
# Redirect URI: https://your-domain.com/api/auth/callback/google (prod)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Resend API Key for sending emails
RESEND_API_KEY=your_resend_api_key_here

# Telegram API credentials for Telegram login
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
