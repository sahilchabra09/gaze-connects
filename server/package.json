    "@sinclair/typebox": "^0.34.0",
    "ai": "^6.0.141",
    "better-auth": "^1.5.6",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "elysia": "latest",
    "mqtt": "^5.15.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.8",
    "prebuilt-tdlib": "^0.1008052.1",
    "resend": "^6.9.4",
    "tdl": "^8.0.3",
